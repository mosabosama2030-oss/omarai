# Required for a hosted production deployment. Generate a random secret with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
OMARAI_PUBLIC_DEPLOYMENT=1
OMARAI_ACCESS_TOKEN=replace-with-a-random-secret-at-least-32-characters
OPENROUTER_API_KEY=replace-with-your-own-provider-key

# Optional: pin stable/paid models after checking current availability and price.
# OMARAI_PLANNER_MODEL=provider/model-id
# OMARAI_ANSWER_MODEL=provider/model-id
# OMARAI_REVIEW_MODEL=provider/model-id
# OMARAI_LLM_FALLBACK_MODEL=openrouter/free

# Optional live search APIs; may require separate accounts/credits.
# BRAVE_SEARCH_API_KEY=
# TAVILY_API_KEY=
